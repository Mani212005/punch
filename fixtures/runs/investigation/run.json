    { "match": "/releases", "file": "http/qs_releases.json" },
    { "match": "/compare/", "file": "http/qs_compare.json" }
  ],
  "agents": {
    "planner": {
      "plan": {
        "subtasks": [
          {
            "id": "s-inv",
            "title": "List repository dependencies",
            "description": "Fetch the vuln-shop source and list every dependency from package.json and lockfiles with resolved versions. Accept when the inventory names qs 6.5.2 and unused-vuln-lib 1.0.0 with evidence.",
            "dependsOn": [],
            "roleHint": "inventory",
            "output": { "key": "inventory" },
            "inputKeys": []
          },
          {
            "id": "s-vuln",
            "title": "Research vulnerabilities",
            "description": "Query OSV and the npm registry for each inventoried dependency; record advisories, severity, affected symbols and patched versions from two independent sources. Accept when every dependency has a sourced verdict.",
            "dependsOn": [],
            "roleHint": "researcher",
            "output": { "key": "vulns" },
            "inputKeys": []
          },
          {
            "id": "s-reach",
            "title": "Assess reachability",
            "description": "For each researched vulnerability, prove exists vs exposed vs exploitable from the import graph, call sites of affected symbols, entrypoints, routes and tests. Accept when every vulnerability has a REACHABLE / NOT_REACHABLE / UNKNOWN verdict backed by a completed search.",
            "dependsOn": ["s-inv", "s-vuln"],
            "roleHint": "reachability",
            "output": { "key": "reachability" },
            "inputKeys": ["inventory", "vulns"]
          },
          {
            "id": "s-impact",
            "title": "Assess upgrade impact",
            "description": "For each candidate upgrade, compare versions, read release notes and changelogs, and check removed APIs against repository usage. Accept when every upgrade has a LOW / MEDIUM / HIGH level with risks and unknowns, never a percentage.",
            "dependsOn": ["s-inv", "s-vuln"],
            "roleHint": "impact",
            "output": { "key": "upgrade_impact" },
            "inputKeys": ["inventory", "vulns"]
          },
          {
            "id": "s-invest",
            "title": "Synthesize security findings",
            "description": "Reconcile inventory, research, reachability and impact into one finding per vulnerability with a recommended action and candidate remediations for the sandbox. Accept when every finding follows the recommendation rules with blackboard-cited evidence.",
            "dependsOn": ["s-reach", "s-impact"],
            "roleHint": "investigator",
            "output": { "key": "findings" },
            "inputKeys": ["inventory", "vulns", "reachability", "upgrade_impact"]
          },
          {
            "id": "s-valid",
            "title": "Validate remediations in sandbox",
            "description": "Code-driven: simulate each candidate remediation from the investigator in the isolated sandbox and record PASS / FAIL / NOT_RUN with test counts. No agent is routed to this subtask.",
            "dependsOn": ["s-invest", "s-inv"],
            "roleHint": "investigator",
            "output": { "key": "validation_1" },
            "inputKeys": ["findings", "inventory"],
            "sandboxValidation": true
          },
          {
            "id": "s-report",
            "title": "Write investigation report",
            "description": "Write the section-8 security investigation report: counts, per-finding reachability with evidence, upgrade and impact, sandbox validation, critic verdict and recommended action. Accept when every finding is covered and unknowns are listed, not hidden.",
            "dependsOn": ["s-invest", "s-valid"],
            "roleHint": "executor",
            "output": { "key": "report" },
            "inputKeys": ["findings", "validation_1"]
          }
        ]
      },
      "replan": {
        "subtasks": [
          {
            "id": "s-reach2",
            "title": "Reachability analysis",
            "description": "Targeted replan after the critic rejected the reachability claim: perform call-site analysis for qs.parse and confirm the import-graph absence for unused-vuln-lib. Accept when both verdicts cite completed searches.",
            "dependsOn": ["s-inv", "s-vuln"],
            "roleHint": "reachability",
            "output": { "key": "reachability_2" },
            "inputKeys": ["inventory", "vulns"]
          },
          {
            "id": "s-invest2",
            "title": "Synthesize findings again",
            "description": "Re-synthesize the findings on the redone reachability evidence with blackboard-cited claims. Accept when both findings follow the recommendation rules.",
            "dependsOn": ["s-reach2", "s-impact"],
            "roleHint": "investigator",
            "output": { "key": "findings_2" },
            "inputKeys": ["inventory", "vulns", "reachability_2", "upgrade_impact"]
          },
          {
            "id": "s-valid2",
            "title": "Validate remediations in sandbox again",
            "description": "Code-driven: simulate each candidate remediation in the isolated sandbox. No agent is routed to this subtask.",
            "dependsOn": ["s-invest2", "s-inv"],
            "roleHint": "investigator",
            "output": { "key": "validation_2" },
            "inputKeys": ["findings_2", "inventory"],
            "sandboxValidation": true
          },
          {
            "id": "s-report2",
            "title": "Write investigation report again",
            "description": "Write the section-8 report on the re-investigated findings. Accept when every finding is covered and unknowns are listed.",
            "dependsOn": ["s-invest2", "s-valid2"],
            "roleHint": "executor",
            "output": { "key": "report" },
            "inputKeys": ["findings_2", "validation_2"]
          }
        ]
      }
    },
    "critic": {
      "reject": {
        "s-invest": [
          {
            "claim": "qs.parse is reachable from the /search route",
            "problem": "Reachability claim was unsupported: no call-site analysis was performed.",
            "severity": "blocker",
            "requestedTask": {
              "title": "Reachability analysis",
              "description": "Perform call-site analysis for qs.parse and confirm the import-graph absence for unused-vuln-lib",
              "roleHint": "reachability"
            }
          }
        ]
      }
    },
    "inventory": {
      "s-inv": {
        "calls": [
          {
            "tool": "parse_dependency_inventory",
            "input": {
              "packageJson": "{\n  \"name\": \"vuln-shop\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Fixture shop app: qs is used on a reachable route, unused-vuln-lib is never imported\",\n  \"main\": \"src/server.js\",\n  \"scripts\": { \"start\": \"node src/server.js\", \"test\": \"node --test test/\" },\n  \"dependencies\": { \"qs\": \"6.5.2\", \"unused-vuln-lib\": \"1.0.0\" }\n}"
            },
            "require": "direct"
          }
        ],
        "result": {
