            "tool": "analyze_import_graph",
            "input": { "workdir": "$FIXTURE_DIR/repo", "targetPackages": ["qs", "unused-vuln-lib"] }
          },
          {
            "tool": "find_call_sites",
            "input": { "workdir": "$FIXTURE_DIR/repo", "package": "qs", "symbols": ["parse"] }
