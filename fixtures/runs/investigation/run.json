              "toolCallId": "$1",
              "quote": "direct: qs@6.5.2, unused-vuln-lib@1.0.0"
            },
            {
              "claim": "no lockfile is present, so exact resolved versions come from the manifest specifiers",
              "source": "parse_dependency_inventory",
              "toolCallId": "$1",
              "quote": "lockfileType: none"
            }
          ]
        },
        "degraded": {
