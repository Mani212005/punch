        }
      }
    },
    "researcher": {
      "s-vuln": {
        "calls": [
          {
            "tool": "osv_query_batch",
            "input": {
              "queries": [
                { "package": { "name": "qs", "ecosystem": "npm" }, "version": "6.5.2" },
                { "package": { "name": "unused-vuln-lib", "ecosystem": "npm" }, "version": "1.0.0" }
              ]
            },
            "require": "results"
          },
          { "tool": "get_package_metadata", "input": { "package": "qs" }, "require": "metadata.dist-tags" },
          {
            "tool": "get_package_metadata",
            "input": { "package": "unused-vuln-lib" },
            "require": "metadata.dist-tags"
          }
        ],
        "result": {
          "value": {
